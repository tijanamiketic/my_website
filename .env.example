# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Every variable is optional — the site works without any of them.

# Public URL of the site (canonical links, sitemap, Open Graph).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Your Skool community — every "Join / Enroll" button links here.
# Overrides profile.skoolUrl in content/profile.ts.
#NEXT_PUBLIC_SKOOL_URL=https://www.skool.com/your-community

# Chatbot. Without a key the chat uses the built-in mock responder.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5). For a cheaper bot: claude-haiku-4-5
ANTHROPIC_MODEL=
